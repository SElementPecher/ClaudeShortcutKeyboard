<?xml version="1.0" encoding="utf-8"?>
<!-- "How blanks work": a short line, then each example with what it does. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="?android:attr/dialogPreferredPadding"
        android:paddingTop="@dimen/app_gap_small"
        android:paddingEnd="?android:attr/dialogPreferredPadding"
        android:paddingBottom="@dimen/app_gap_small">

        <TextView
            style="@style/AppText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/app_gap_small"
            android:text="@string/help_intro" />

        <TextView
            style="@style/AppText.Code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_gap"
            android:text="@string/help_choice_code" />

        <TextView
            style="@style/AppText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_choice" />

        <TextView
            style="@style/AppText.Code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_gap"
            android:text="@string/help_time_code" />

        <TextView
            style="@style/AppText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_time" />

        <TextView
            style="@style/AppText.Code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_gap"
            android:text="@string/help_later_code" />

        <TextView
            style="@style/AppText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_later" />

        <TextView
            style="@style/AppText.Code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_gap"
            android:text="@string/help_minutes_code" />

        <TextView
            style="@style/AppText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_minutes" />

        <TextView
            style="@style/AppText.Code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_gap"
            android:text="@string/help_today_code" />

        <TextView
            style="@style/AppText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_today" />
    </LinearLayout>
</ScrollView>
