<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top bar. Its top padding is set in code to clear the status bar. -->
    <LinearLayout
        android:id="@+id/main_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical">

        <Toolbar
            android:id="@+id/main_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:title="@string/app_name" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- Focusable so the "Try it" box does not grab focus and pop up the keyboard on start. -->
        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="@dimen/app_screen_padding">

            <!-- Setup steps, shown until the keyboard is turned on and picked. -->
            <LinearLayout
                android:id="@+id/setup_card"
                style="@style/AppCard">

                <TextView
                    style="@style/AppText.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_title" />

                <LinearLayout
                    android:id="@+id/setup_step1_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_gap"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/setup_step1_badge"
                        style="@style/AppStepBadge"
                        android:background="@drawable/app_step_todo"
                        android:text="@string/setup_step1_number"
                        android:textColor="@color/primary" />

                    <TextView
                        style="@style/AppText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_step1" />
                </LinearLayout>

                <Button
                    android:id="@+id/setup_step1_button"
                    style="@style/AppButton.Primary"
                    android:layout_marginTop="@dimen/app_gap_small"
                    android:text="@string/setup_step1_button" />

                <LinearLayout
                    android:id="@+id/setup_step2_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_gap"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/setup_step2_badge"
                        style="@style/AppStepBadge"
                        android:background="@drawable/app_step_todo"
                        android:text="@string/setup_step2_number"
                        android:textColor="@color/primary" />

                    <TextView
                        style="@style/AppText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_step2" />
                </LinearLayout>

                <Button
                    android:id="@+id/setup_step2_button"
                    style="@style/AppButton.Primary"
                    android:layout_marginTop="@dimen/app_gap_small"
                    android:text="@string/setup_step2_button" />

                <TextView
                    style="@style/AppText.Help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_gap"
                    android:text="@string/setup_privacy" />
            </LinearLayout>

            <!-- Shown instead of the setup card once both steps are done. -->
            <TextView
                android:id="@+id/setup_ready"
                style="@style/AppText.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/app_gap"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/setup_ready"
                android:textColor="@color/success"
                android:visibility="gone" />

            <!-- Try it -->
            <LinearLayout style="@style/AppCard">

                <TextView
                    style="@style/AppText.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/try_title" />

                <EditText
                    android:id="@+id/try_field"
                    style="@style/AppField"
                    android:layout_marginTop="@dimen/app_gap"
                    android:gravity="top|start"
                    android:hint="@string/try_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2" />

                <TextView
                    android:id="@+id/try_tip"
                    style="@style/AppText.Help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_gap_small"
                    android:text="@string/try_tip" />
            </LinearLayout>

            <!-- Your shortcuts -->
            <TextView
                style="@style/AppText.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/shortcuts_title" />

            <LinearLayout
                android:id="@+id/shortcut_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/shortcuts_empty"
                style="@style/AppText.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/app_gap"
                android:text="@string/shortcuts_empty"
                android:visibility="gone" />

            <Button
                android:id="@+id/new_shortcut_button"
                style="@style/AppButton.Primary"
                android:text="@string/shortcut_new" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
