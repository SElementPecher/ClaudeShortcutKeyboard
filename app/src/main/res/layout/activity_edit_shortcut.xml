<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top bar. Its top padding is set in code to clear the status bar. -->
    <LinearLayout
        android:id="@+id/edit_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical">

        <Toolbar
            android:id="@+id/edit_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize">

            <Button
                android:id="@+id/edit_toolbar_save"
                style="@style/AppButton.Toolbar"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/app_gap_tiny"
                android:text="@string/edit_save" />
        </Toolbar>
    </LinearLayout>

    <ScrollView
        android:id="@+id/edit_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/edit_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="@dimen/app_screen_padding">

            <!-- Where it lives (only shown inside a folder) -->
            <TextView
                android:id="@+id/edit_folder"
                style="@style/AppText.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/app_gap"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- Name and message -->
            <LinearLayout
                style="@style/AppCard"
                android:paddingTop="4dp">

                <TextView
                    style="@style/AppText.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/edit_name"
                    android:text="@string/edit_name_label" />

                <EditText
                    android:id="@+id/edit_name"
                    style="@style/AppField"
                    android:hint="@string/edit_name_hint"
                    android:importantForAutofill="no"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:saveEnabled="false" />

                <TextView
                    android:id="@+id/edit_name_error"
                    style="@style/AppText.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/AppText.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/edit_message"
                    android:text="@string/edit_message_label" />

                <EditText
                    android:id="@+id/edit_message"
                    style="@style/AppField"
                    android:gravity="top|start"
                    android:hint="@string/edit_message_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:saveEnabled="false" />

                <TextView
                    style="@style/AppText.Help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_message_help" />

                <TextView
                    android:id="@+id/edit_message_error"
                    style="@style/AppText.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/edit_add_blank"
                    style="@style/AppButton.Outline"
                    android:layout_marginTop="@dimen/app_gap"
                    android:text="@string/edit_add_blank" />

                <Button
                    android:id="@+id/edit_add_time_later"
                    style="@style/AppButton.Outline"
                    android:layout_marginTop="@dimen/app_gap_small"
                    android:text="@string/edit_add_time_later" />

                <Button
                    android:id="@+id/edit_help"
                    style="@style/AppButton.Text"
                    android:layout_marginTop="@dimen/app_gap_tiny"
                    android:text="@string/edit_help_link" />
            </LinearLayout>

            <!-- Blanks: one card per blank in the message, filled in by code. -->
            <TextView
                style="@style/AppText.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:accessibilityHeading="true"
                android:text="@string/edit_blanks_title" />

            <TextView
                style="@style/AppText.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="@dimen/app_gap"
                android:text="@string/edit_blanks_help" />

            <LinearLayout
                android:id="@+id/edit_blanks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/edit_no_blanks"
                style="@style/AppText.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="@dimen/app_gap"
                android:text="@string/edit_no_blanks"
                android:visibility="gone" />

            <TextView
                android:id="@+id/edit_built_in_note"
                style="@style/AppText.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="@dimen/app_gap"
                android:text="@string/edit_built_in_note"
                android:visibility="gone" />

            <!-- Preview -->
            <LinearLayout style="@style/AppCard">

                <TextView
                    style="@style/AppText.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_preview_title" />

                <TextView
                    style="@style/AppText.Help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_preview_help" />

                <TextView
                    android:id="@+id/edit_preview"
                    style="@style/AppText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_gap"
                    android:textSize="@dimen/app_text_field" />
            </LinearLayout>

            <Button
                android:id="@+id/edit_save_button"
                style="@style/AppButton.Primary"
                android:layout_marginTop="@dimen/app_gap_small"
                android:text="@string/edit_save_button" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
