<?xml version="1.0" encoding="utf-8"?>
<!-- A normal key (letters, symbols, space). The gap between keys is added in code. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kb_key_radius" />
            <solid android:color="@color/kb_key_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kb_key_radius" />
            <solid android:color="@color/kb_key" />
        </shape>
    </item>
</selector>
