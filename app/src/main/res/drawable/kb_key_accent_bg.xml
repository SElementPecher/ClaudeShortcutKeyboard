<?xml version="1.0" encoding="utf-8"?>
<!-- The enter key and the main "Insert" buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kb_key_radius" />
            <solid android:color="@color/kb_accent_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kb_key_radius" />
            <solid android:color="@color/kb_accent" />
        </shape>
    </item>
</selector>
