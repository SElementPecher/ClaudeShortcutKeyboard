<?xml version="1.0" encoding="utf-8"?>
<!-- Shift, delete, page keys and plain buttons. "Activated" means shift is on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kb_key_radius" />
            <solid android:color="@color/kb_key_special_pressed" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kb_key_radius" />
            <solid android:color="@color/kb_chip_selected" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kb_key_radius" />
            <solid android:color="@color/kb_key_special" />
        </shape>
    </item>
</selector>
