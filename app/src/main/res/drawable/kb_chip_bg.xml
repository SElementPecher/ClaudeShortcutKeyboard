<?xml version="1.0" encoding="utf-8"?>
<!-- A rounded chip: shortcuts in the bar and options while filling in a blank. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/kb_key_pressed" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/kb_chip_selected" />
            <stroke android:width="2dp" android:color="@color/kb_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/kb_chip" />
        </shape>
    </item>
</selector>
