<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cards: rounded surface boxes stacked down the screen. -->
    <style name="AppCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/app_gap</item>
        <item name="android:background">@drawable/app_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/app_card_padding</item>
    </style>

    <!-- Text -->
    <style name="AppText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/app_text_body</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="AppText.Heading">
        <item name="android:textSize">@dimen/app_text_heading</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppText.Section">
        <item name="android:textSize">@dimen/app_text_section</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">@dimen/app_gap_small</item>
        <item name="android:layout_marginBottom">@dimen/app_gap_small</item>
    </style>

    <!-- A label above a field. -->
    <style name="AppText.Label">
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">@dimen/app_gap</item>
        <item name="android:layout_marginBottom">@dimen/app_gap_tiny</item>
    </style>

    <style name="AppText.Help">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/app_text_help</item>
        <item name="android:layout_marginTop">@dimen/app_gap_tiny</item>
    </style>

    <style name="AppText.Error">
        <item name="android:textColor">@color/danger</item>
        <item name="android:textSize">@dimen/app_text_help</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">@dimen/app_gap_tiny</item>
        <item name="android:accessibilityLiveRegion">polite</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- A blank as written in a message, e.g. {child}. -->
    <style name="AppText.Code">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/app_text_code</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="AppText.Chip">
        <item name="android:background">@drawable/app_chip</item>
        <item name="android:textSize">@dimen/app_text_help</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Buttons -->
    <style name="AppButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/app_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">@dimen/app_text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="AppButton.Primary">
        <item name="android:background">@drawable/app_button_primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="AppButton.Outline">
        <item name="android:background">@drawable/app_button_outline</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- A plain text button, e.g. "How do blanks work?". -->
    <style name="AppButton.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/app_button_text</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:gravity">center_vertical|start</item>
    </style>

    <!-- The small Save button in the top bar. -->
    <style name="AppButton.Toolbar" parent="AppButton.Primary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minHeight">@dimen/app_toolbar_button_height</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <!-- Text fields -->
    <style name="AppField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/app_field_min_height</item>
        <item name="android:background">@drawable/app_field</item>
        <item name="android:padding">@dimen/app_field_padding</item>
        <item name="android:textSize">@dimen/app_text_field</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <style name="AppSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/app_field_min_height</item>
        <item name="android:background">@drawable/app_spinner</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">44dp</item>
        <item name="android:popupBackground">@drawable/app_popup</item>
    </style>

    <!-- The round number or tick next to a setup step. -->
    <style name="AppStepBadge">
        <item name="android:layout_width">@dimen/app_step_badge</item>
        <item name="android:layout_height">@dimen/app_step_badge</item>
        <item name="android:layout_marginEnd">@dimen/app_gap</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/app_text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
