    <!-- How blanks work -->
    <string name="help_title">How blanks work</string>
    <string name="help_intro">A blank is a word in curly brackets. When you use the shortcut, the keyboard asks you to fill it in, one question at a time.</string>
    <string name="help_choice_code" translatable="false">{child}</string>
    <string name="help_choice">You pick it from a list or type it. Like Sam.</string>
    <string name="help_time_code" translatable="false">{time}</string>
    <string name="help_time">A time. It starts at the time now. Like 20:20.</string>
    <string name="help_later_code" translatable="false">{time+4h}</string>
    <string name="help_later">4 hours after {time}. Like 00:20.</string>
    <string name="help_minutes_code" translatable="false">{time+30m}</string>
